<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <statusListener class="ch.qos.logback.core.status.OnConsoleStatusListener"/>

    <springProperty scope="context" name="LOG_PATH" source="app.logger.path"/>
    <springProperty scope="context" name="SPRING_CONSOLE_WRITER_ENABLED" source="app.logger.console.enabled"/>
    <springProperty scope="context" name="SPRING_FILE_WRITER_ENABLED" source="app.logger.file.enabled"/>

    <property name="LOG_PATH" value="${LOG_PATH}"/>
    <property name="LOGBACK_CONSOLE_WRITER_ENABLED" value="${SPRING_CONSOLE_WRITER_ENABLED}"/>
    <property name="LOGBACK_FILE_WRITER_ENABLED" value="${SPRING_FILE_WRITER_ENABLED}"/>

    <timestamp key="bySecond" datePattern="yyyyMMdd'T'HHmmss"/>

    <condition class="ch.qos.logback.core.boolex.ExpressionPropertyCondition">
        <expression>propertyEquals("LOGBACK_FILE_WRITER_ENABLED", "true")</expression>
    </condition>
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_PATH}/log-${bySecond}.txt</file>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeContext>false</includeContext>
        </encoder>
    </appender>

    <condition class="ch.qos.logback.core.boolex.ExpressionPropertyCondition">
        <expression>propertyEquals("LOGBACK_CONSOLE_WRITER_ENABLED", "true")</expression>
    </condition>
    <appender name = "STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} - %-5level %logger{35} - [%X{requestId}] - %msg %ex%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <logger name="backend.academy.linktracker.bot.configuration.logging.LogstashLoggerConfig"
            level="INFO"
            additivity="false">
        <appender-ref ref="FILE"/>
    </logger>

</configuration>
